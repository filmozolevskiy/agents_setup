# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# The qa_assistant scaffold (runners + playwright tests) reads this same
# file. Set TARGET=<brand>-<environment> to activate a URL pair, e.g.:
#   TARGET=flighthub-staging2  npx playwright test --project=flighthub-staging2
#   TARGET=justfly-staging99   npx tsx runners/qa-search.ts ...

# ============================================================================
# Brand × Environment URL matrix (qa_assistant scaffold)
# ============================================================================

# === Flighthub ===
FLIGHTHUB_STAGING1_APP_URL=
FLIGHTHUB_STAGING1_API_URL=

FLIGHTHUB_STAGING2_APP_URL=https://staging2.flighthub.com
FLIGHTHUB_STAGING2_API_URL=https://staging2.flighthub.com

FLIGHTHUB_STAGING3_APP_URL=
FLIGHTHUB_STAGING3_API_URL=

FLIGHTHUB_STAGING99_APP_URL=https://staging99.flighthub.com
FLIGHTHUB_STAGING99_API_URL=https://staging99.flighthub.com

FLIGHTHUB_PROD_APP_URL=https://www.flighthub.com
FLIGHTHUB_PROD_API_URL=https://www.flighthub.com

# === JustFly ===
JUSTFLY_STAGING1_APP_URL=
JUSTFLY_STAGING1_API_URL=

JUSTFLY_STAGING2_APP_URL=https://staging2.justfly.com
JUSTFLY_STAGING2_API_URL=https://staging2.justfly.com

JUSTFLY_STAGING3_APP_URL=
JUSTFLY_STAGING3_API_URL=

JUSTFLY_STAGING99_APP_URL=https://staging99.justfly.com
JUSTFLY_STAGING99_API_URL=https://staging99.justfly.com

JUSTFLY_PROD_APP_URL=https://www.justfly.com
JUSTFLY_PROD_API_URL=https://www.justfly.com

# ClickHouse (Phoenix analytics)
CLICKHOUSE_HOST=<host>
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=<user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DATABASE=default
# Optional. Defaults to http on 8123/9000, https on 8443/443.
# CLICKHOUSE_PROTOCOL=http

# MySQL (genesis database)
MYSQL_HOST=<host>
MYSQL_PORT=3307
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
MYSQL_DATABASE=ota

# MongoDB (debug_logs / optimizer_logs)
MONGODB_URI=mongodb://<host>:27017/
MONGODB_DATABASE=ota

# Looker (only needed for the Looker MCP — .cursor/skills/looker/scripts/mcp_looker.sh)
LOOKER_BASE_URL=https://<your-instance>.looker.com
LOOKER_CLIENT_ID=<looker client id>
LOOKER_CLIENT_SECRET=<looker client secret>
LOOKER_VERIFY_SSL=true

# Local genesis checkout for code-aware questions (codebase_access skill).
# Default location lives under the skill folder and is gitignored.
GENESIS_PATH=/absolute/path/to/agents_setup/.cursor/skills/codebase_access/codebase
# Branch the sync script fast-forwards to (genesis HEAD branch).
GENESIS_BRANCH=develop

# Local genesis-storefront checkout (front-end: home/search/checkout pages;
# same codebase_access skill). Default location lives under the skill folder
# and is gitignored.
STOREFRONT_PATH=/absolute/path/to/agents_setup/.cursor/skills/codebase_access/codebase-storefront
# Branch the sync script fast-forwards to (genesis-storefront HEAD branch).
STOREFRONT_BRANCH=develop

# Optional: codebase-memory-mcp binary (usually ~/.local/bin/codebase-memory-mcp)
# CODEBASE_MEMORY_MCP=codebase-memory-mcp/

# QA automation (only needed for /qa_assistant)
QA_ENV=staging
QA_STAGING_PREFIX=staging2
QA_WORKER_COUNT=1
# QA_CARD_POOL_JSON=/path/to/cards.json
QA_JWT_FH_SECRET=<flighthub jwt secret>
QA_JWT_JF_SECRET=<justfly jwt secret>
QA_TRACE=1
QA_VIDEO=0

# QA backoffice logins (Summit / Respro)
SUMMIT_USER=<email>
SUMMIT_PASS=<password>
# Optional override; defaults to https://staging2-summit.flighthub.com when unset.
# Production Summit is out of scope for qa-summit-stats (staging only).
# SUMMIT_URL=https://staging2-summit.flighthub.com
RESPRO_URL=https://reservations.voyagesalacarte.ca
RESPRO_USER=<user>
RESPRO_PASS=<password>

# Shared genesis test customer (qa_assistant auth specs)
APP_EMAIL=<email+qa@domain>
APP_PASSWORD=<password>

# Per-brand seeded bookings (ref-search / portal-detail specs)
# Refresh when a booking is cancelled — see Trello card KKuEIcGg.
BOOKING_ID_FH=<flighthub booking id>
BOOKING_ID_HASH_FH=<flighthub bookings.id_hash>
BOOKING_LAST_NAME_FH=<contact last name>
BOOKING_ID_JF=<justfly booking id>
BOOKING_ID_HASH_JF=<justfly bookings.id_hash>
BOOKING_LAST_NAME_JF=<contact last name>

# GitHub (deployment_review skill + GitHub MCP — .cursor/skills/deployment_review/scripts/mcp_github.sh)
GITHUB_USERNAME=<github username>
GITHUB_PERSONAL_ACCESS_TOKEN=<personal access token>

# Trello (trello_assistant skill — .cursor/skills/trello_assistant/scripts/mcp_trello.sh)
TRELLO_API_KEY=<trello api key>
TRELLO_TOKEN=<trello token>

# GrowthBook MCP (.cursor/skills/growthbook/scripts/mcp_growthbook.sh)
# Management REST API — NOT the SDK client key genesis uses (growthbook_client_key).
# Mint an API key / PAT in GrowthBook → Settings → API Keys. Read scope is enough to inspect flags.
GB_API_KEY=<growthbook api key or personal access token>
GB_EMAIL=<your growthbook account email>
# FlightHub self-hosts GrowthBook — API and app are on different hosts:
GB_API_URL=https://gb-api.flighthub.com
GB_APP_ORIGIN=https://gb.flighthub.com
