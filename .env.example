# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ClickHouse (Phoenix analytics)
CLICKHOUSE_HOST=<host>
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=<user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DATABASE=default
# Optional. Defaults to http on 8123/9000, https on 8443/443.
# CLICKHOUSE_PROTOCOL=http

# MySQL (genesis database)
MYSQL_HOST=<host>
MYSQL_PORT=3307
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
MYSQL_DATABASE=ota

# MongoDB (debug_logs / optimizer_logs)
MONGODB_URI=mongodb://<host>:27017/
MONGODB_DATABASE=ota

# Looker (only needed for the Looker MCP — .cursor/skills/looker/scripts/mcp_looker.sh)
LOOKER_BASE_URL=https://<your-instance>.looker.com
LOOKER_CLIENT_ID=<looker client id>
LOOKER_CLIENT_SECRET=<looker client secret>
LOOKER_VERIFY_SSL=true

# Local genesis checkout for code-aware questions (codebase_access skill).
# Default location lives under the skill folder and is gitignored.
GENESIS_PATH=/absolute/path/to/agents_setup/.cursor/skills/codebase_access/codebase
# Branch the sync script fast-forwards to (genesis HEAD branch).
GENESIS_BRANCH=develop

# Optional: codebase-memory-mcp binary (usually ~/.local/bin/codebase-memory-mcp)
# CODEBASE_MEMORY_MCP=codebase-memory-mcp/

# QA automation (only needed for /qa_automation)
QA_ENV=staging
QA_STAGING_PREFIX=staging2
QA_WORKER_COUNT=1
# QA_CARD_POOL_JSON=/path/to/cards.json
QA_JWT_FH_SECRET=<flighthub jwt secret>
QA_JWT_JF_SECRET=<justfly jwt secret>
QA_TRACE=1
QA_VIDEO=0

# QA backoffice logins (Summit / Respro)
SUMMIT_USER=<email>
SUMMIT_PASS=<password>
RESPRO_USER=<user>
RESPRO_PASS=<password>

# Gmail (only needed for the Gmail MCP — .cursor/skills/reporter/scripts/mcp_gmail.sh)
# Both credentials are base64-encoded JSON blobs; the wrapper materialises them
# to a per-process tmp dir at launch and deletes them on exit (no on-disk
# credentials outside .env). One-time setup: see .cursor/skills/reporter/servers.md § Gmail.
#
# 1. OAuth client from Google Cloud Console (Desktop app or Web app type):
#      base64 -i client_secret_<id>.json | tr -d '\n'
GMAIL_OAUTH_KEYS_B64=<base64 of gcp-oauth.keys.json>
# 2. Browser-flow credentials, produced by:
#      ./.cursor/skills/reporter/scripts/mcp_gmail.sh auth
#    The script prints the line to paste here.
GMAIL_CREDENTIALS_B64=<base64 of credentials.json>

# Slack: nothing here. The reporter skill drives the Cursor Slack plugin
# (server identifier `plugin-slack-slack`), which holds its own auth via
# the Cursor plugin system. Authenticate by calling the plugin's
# `mcp_auth` tool from any agent session, or use the Cursor UI's plugin
# settings. See .cursor/skills/reporter/servers.md § Slack.
